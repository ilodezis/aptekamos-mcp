# Password typed once on the consent page when connecting Claude.ai.
PASSWORD=
# Token signing key. Rotating it revokes every issued token (Claude must reconnect).
# openssl rand -base64 48
TOKEN_SECRET=
# OAuth client, entered in the connector's advanced settings on Claude.ai.
CLIENT_ID=aptekamos-claude-connector
CLIENT_SECRET=
# Optional externally visible HTTPS origin (e.g. https://example.com); falls back to forwarded headers if unset.
# PUBLIC_URL=
# Comma-separated; defaults to https://claude.ai/api/mcp/auth_callback and https://claude.com/api/mcp/auth_callback.
# REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
